      "sha256": "a2ac9ff442b2ade7a352c2271e4e6d82d9be51b1eefa9a0cf8b8d36cad35a59c",
      "description": "A generative ambient test: a slow drone that drifts to new roots, random minor-pentatonic FM bells and a stereo feedback delay. Starts playing at power-on; the keys play a soft pad.",
      "controls": [
        [
          "K1 DARK",
          "Darker drone filter, softer bells"
        ],
        [
          "K2 ACTIVITY",
          "How often bells ring (0.05 to 2.5 a second)"
        ],
        [
          "K3 DECAY",
          "How long bells ring (0.6 to 10 s)"
        ],
        [
          "K4 SPACE",
          "Delay amount and feedback"
        ],
        [
          "PLAY",
          "Start / stop (fades)"
        ],
        [
          "SEQ",
          "New random root"
        ],
        [
          "OCT- / OCT+",
          "Pad octave"
        ],
        [
          "SAVE",
          "Keep the knobs and root"
        ]
      ],
      "tags": [
        "generative",
        "ambient"
      ],
      "license": "MPL-2.0",
      "credits": "Built on fm1-base by Charles Vestal and felucca-bsp by Leo Kuroshita.",
